{
	"id": "/",
	"scope": "/",
	"name": "Links - Mike Odnis",
	"short_name": "Links",
	"description": "Fast, security-verified short links with click analytics on links.mikeodnis.dev.",
	"lang": "en-US",
	"dir": "ltr",
	"start_url": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "any",
	"theme_color": "#0c0c14",
	"background_color": "#0c0c14",
	"categories": ["utilities", "productivity"],
	"prefer_related_applications": false,
	"related_applications": [],
	"edge_side_panel": {
		"preferred_width": 480
	},
	"launch_handler": {
		"client_mode": "auto"
	},
	"handle_links": "preferred",
	"scope_extensions": [{ "origin": "*.mikeodnis.dev" }],
	"share_target": {
		"action": "/create",
		"method": "GET",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	},
	"icons": [
		{
			"src": "/pwa/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/pwa/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/pwa/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/pwa/maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/pwa/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Create Link",
			"short_name": "Create",
			"description": "Shorten and security-verify a new URL",
			"url": "/create",
			"icons": [
				{
					"src": "/pwa/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Dashboard",
			"short_name": "Dashboard",
			"description": "Manage your short links and view click analytics",
			"url": "/dashboard",
			"icons": [
				{
					"src": "/pwa/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "API Keys",
			"short_name": "Keys",
			"description": "Manage programmatic API keys",
			"url": "/keys",
			"icons": [
				{
					"src": "/pwa/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		}
	]
}
